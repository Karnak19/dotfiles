{
  "$schema": "https://opencode.ai/config.json",
  "model": "console-z-ai/glm-5.3",
  "disabled_providers": [
    "github-copilot"
  ],
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "mcp": {
    "servers": {
      "coolify": {
        "type": "remote",
        "url": "https://coolify.vernouillet.dev/mcp",
        "headers": {
          "Authorization": "Bearer {env:COOLIFY_API_TOKEN}"
        }
      },
      "rustrak": {
        "type": "remote",
        "url": "https://rustrack.bazlab.si/mcp",
        "headers": {
          "Authorization": "Bearer {env:RUSTRAK_API_TOKEN}"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim",
    "file:///Users/basilevernouillet/.config/opencode/plugins/session-dashboard",
    "github:Karnak19/opencode-mac-notify"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.local",
      "effect": "ask"
    }
  ]
}
