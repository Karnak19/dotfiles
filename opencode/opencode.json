{
  "$schema": "https://opencode.ai/config.json",
  "model": "console-z-ai/glm-5.3",
  "disabled_providers": [
    "github-copilot"
  ],
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "mcp": {
    "cloudflare-api": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
