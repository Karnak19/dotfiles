{
  "$schema": "https://opencode.ai/config.json",
  "model": "console-z-ai/glm-5.3",
  "disabled_providers": [
    "github-copilot"
  ],
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "mcp": {
    "servers": {
      "coolify": {
        "type": "remote",
        "url": "https://coolify.vernouillet.dev/mcp",
        "headers": {
          "Authorization": "Bearer {env:COOLIFY_API_TOKEN}"
        }
      },
      "rustrak": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@rustrak/mcp"
        ],
        "environment": {
          "RUSTRAK_API_URL": "https://rustrack.bazlab.si",
          "RUSTRAK_API_TOKEN": "{env:RUSTRAK_API_TOKEN}"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim",
    "file:///Users/basilevernouillet/.config/opencode/plugins/session-dashboard"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
